{
  "runtime": { "type": "node", "version": "22" },
  "init": {
    "darwin": "npm install -g .",
    "linux": "npm install -g ."
  },
  "auth": {
    "darwin": "workbuddy-a2a auth connect",
    "linux": "workbuddy-a2a auth connect"
  },
  "status": {
    "darwin": "workbuddy-a2a connection status",
    "linux": "workbuddy-a2a connection status"
  },
  "unAuth": {
    "darwin": "workbuddy-a2a auth logout",
    "linux": "workbuddy-a2a auth logout"
  },
  "statusMatch": "Logged in",
  "env": { "A2A_RELAY_URL": "wss://dsh-relay.chuanbota.com/connect" },
  "authUrlDomain": "dsh-relay.chuanbota.com"
}
